APP_ENV=development
APP_MODE=demo
PORT=8010
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer
SCENARIO_CATALOG_PATH=backend/data/scenarios.demo.halyk.json
AUDIO_RETENTION=false
